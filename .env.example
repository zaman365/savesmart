# Node does not load this file automatically. Set environment variables, or run:
# node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./var/savesmart.sqlite
# Explicitly opt in to illustrative catalogue data and demo accounts locally.
DEMO_MODE=true
# On a public HTTPS deployment set NODE_ENV=production and APP_ORIGIN exactly.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
